[".vim/autoload/plug.vim"]
  type = "file"
  url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
  refreshPeriod = "168h"
{{ if eq .chezmoi.os "darwin" -}}
# Managed at the canonical path iTerm2 itself auto-updates
# ($HOME/.iterm2_shell_integration.zsh). .config/iterm2/iterm2.zsh is a
# symlink to this file so both stay in sync regardless of which side
# refreshes it (chezmoi's periodic re-download or iTerm's own updater).
[".iterm2_shell_integration.zsh"]
  type = "file"
  url = "https://iterm2.com/shell_integration/zsh"
  refreshPeriod = "168h"
{{ end }}
{{ if eq .chezmoi.os "linux" -}}
[".local/bin/eza"]
  type = "archive-file"
  url = "https://github.com/eza-community/eza/releases/download/v0.23.4/eza_x86_64-unknown-linux-gnu.tar.gz"
  executable = true
  path = "./eza"
  refreshPeriod = "168h"
{{ end }}
